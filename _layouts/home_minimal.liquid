<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% assign profile = site.data.profile %}
      {% if page.title %}{{ page.title }}{% elsif profile.name %}{{ profile.name }}{% else %}{{ site.first_name }} {{ site.last_name }}{% endif %}
    </title>
    <link rel="stylesheet" href="{{ '/assets/css/minimal.css' | relative_url }}">
    <link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">
  </head>
  <body>
    {% assign profile = site.data.profile %}
    {% if profile.name %}
      {% assign name = profile.name %}
    {% else %}
      {% assign name = site.first_name | append: ' ' | append: site.last_name %}
    {% endif %}
    {% assign news_limit = profile.news_limit | default: 5 %}
    {% assign posts_limit = profile.posts_limit | default: 3 %}
    {% assign projects_limit = profile.projects_limit | default: 6 %}

    <main>
      <header>
        <h1>{{ name }}</h1>
        {% if profile.affiliation or profile.email %}
          <p class="subtitle">
            {% if profile.affiliation %}{{ profile.affiliation }}{% endif %}
            {% if profile.email %}
              {% if profile.affiliation %} | {% endif %}
              <a href="mailto:{{ profile.email }}">{{ profile.email }}</a>
            {% endif %}
          </p>
        {% endif %}

        {% if profile.links %}
          <p class="links">
            {% for item in profile.links %}
              {% assign link_url = item.url %}
              {% if link_url contains '://' or link_url contains 'mailto:' %}
                <a href="{{ link_url }}">{{ item.label }}</a>{% unless forloop.last %} / {% endunless %}
              {% else %}
                <a href="{{ link_url | relative_url }}">{{ item.label }}</a>{% unless forloop.last %} / {% endunless %}
              {% endif %}
            {% endfor %}
          </p>
        {% endif %}

        {% if profile.bio or profile.photo %}
          <div class="bio-container">
            {% if profile.photo %}
              <div class="photo-container">
                <img src="{{ '/assets/img/' | append: profile.photo | relative_url }}" alt="{{ name }}" class="profile-photo">
              </div>
            {% endif %}
            {% if profile.bio %}
              <p class="bio">{{ profile.bio | join: ' ' }}</p>
            {% endif %}
          </div>
        {% endif %}
        {{ content }}
      </header>

      <hr>

      <section id="news">
        <h2>News</h2>
        {% assign news_items = site.news | sort: 'date' | reverse %}
        {% if news_items and news_items.size > 0 %}
          <ul class="list">
            {% for item in news_items limit: news_limit %}
              <li>
                <span class="meta">{{ item.date | date: "%Y-%m-%d" }}</span>
                <span> - {{ item.content | strip_html | strip_newlines }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>

      <section id="publications">
        <h2>Publications</h2>
        <p class="meta">(updating)</p>
      </section>

      <section id="projects">
        <h2>Selected Projects</h2>
        {% assign project_items = site.projects | sort: 'importance' %}
        {% if project_items and project_items.size > 0 %}
          <ul class="list">
            {% for project in project_items limit: projects_limit %}
              <li>
                <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
                {% if project.description %} - {{ project.description }}{% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>

      <section id="posts">
        <h2>Posts</h2>
        {% if site.posts and site.posts.size > 0 %}
          <ul class="list">
            {% for post in site.posts limit: posts_limit %}
              <li>
                <span class="meta">{{ post.date | date: "%Y-%m-%d" }}</span>
                <span> - <a href="{{ post.url | relative_url }}">{{ post.title }}</a></span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    </main>
  </body>
</html>
